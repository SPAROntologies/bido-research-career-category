      }
    ],
    "http://purl.org/vocab/vann/changes": [
      {
        "@language": "en",
        "@value": "\n* **v1.1.1**: Added new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.\n    "
      }
    ],
